# BusDrop environment — copy to .env and fill in what you need.
# Everything runs offline without keys; keys upgrade the AI tiers.

# Meta Model API key for the Muse Spark dispatcher + Voice Transcribe.
# Get one at https://dev.meta.ai — needed only for --dispatcher spark.
MODEL_API_KEY=

# Optional: Muse Spark Open rider agents via your own endpoint
# (Baseten / Modal). Without these, riders use the offline patience rule.
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
# SPARK_OPEN_MODEL=muse-spark-open

# Optional: separate key for voice transcription. Falls back to MODEL_API_KEY.
# VOICE_API_KEY=
